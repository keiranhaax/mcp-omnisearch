# Source-only allowlist: never send local credentials/caches to the builder.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!patches/
!patches/*.patch
!tsconfig.json
!vite.config.ts
!src/
!src/**/
!src/**/*.ts
!docker/
!docker/start.py
!docker/requirements.txt

# Defense in depth, including files nested inside an allowed source directory.
**/.env
**/.env.*
**/.hermes
**/.hermes/**
**/.local
**/.local/**
**/node_modules
**/node_modules/**
**/*.test.ts
