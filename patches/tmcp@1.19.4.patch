diff --git a/src/internal/utils.js b/src/internal/utils.js
index 4842cc9ee5e63f18839233659f974aa51344e726..f7eead5b618a489043356d3d2d5b85c124f671dc 100644
--- a/src/internal/utils.js
+++ b/src/internal/utils.js
@@ -10,3 +10,46 @@
 export function event(type, detail) {
 	return new CustomEvent(type, { detail });
 }
+
+/**
+ * Only report schema-owned field names and known constraints. Standard Schema
+ * issues can contain raw inputs, parent objects and value-bearing messages.
+ * @param {ReadonlyArray<import('@standard-schema/spec').StandardSchemaV1.Issue>} issues
+ * @param {any} schema
+ */
+export function summarize_issues(issues, schema) {
+	const constraints = new Set([
+		'array', 'object', 'string', 'number', 'boolean', 'null', 'undefined',
+		'literal', 'picklist', 'union', 'integer', 'finite', 'url', 'email',
+		'min_length', 'max_length', 'length', 'min_value', 'max_value',
+		'min_size', 'max_size', 'size', 'regex', 'check', 'custom',
+	]);
+	const summaries = issues.slice(0, 8).map((issue) => {
+		let current = schema;
+		const path = (issue.path ?? []).slice(0, 6).map((segment) => {
+			// Valibot wraps schema nodes in optional/nullable/pipe schemas.
+			for (let depth = 0; depth < 8; depth++) {
+				const inner = current?.wrapped ?? current?.pipe?.[0];
+				if (!inner || inner === current) break;
+				current = inner;
+			}
+			const key = typeof segment === 'object' ? segment.key : segment;
+			if (typeof key === 'string' && current?.entries && Object.hasOwn(current.entries, key)) {
+				current = current.entries[key];
+				return key.slice(0, 32).replace(/[^a-zA-Z0-9_-]/g, '_');
+			}
+			if (typeof key === 'number' && Number.isSafeInteger(key) && key >= 0 && current?.item) {
+				current = current.item;
+				return key <= 999999 ? key : '*';
+			}
+			current = undefined;
+			return '*';
+		});
+		const detail = /** @type {{type?: string, requirement?: unknown}} */ (issue);
+		const constraint = constraints.has(detail.type ?? '') ? detail.type : 'invalid_value';
+		const requirement = typeof detail.requirement === 'number' && Number.isFinite(detail.requirement)
+			? detail.requirement : undefined;
+		return { path, constraint, ...(requirement !== undefined && { requirement }) };
+	});
+	return JSON.stringify({ issues: summaries, truncated: issues.length > summaries.length });
+}
